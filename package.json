{
  "name": "8bit-sfx",
  "version": "1.0.0",
  "description": "8888 chip sound effects across 44 categories, synthesized on demand in the browser or Node - no audio files, no dependencies. Game SFX and musical sound design, each with a catalog description; optional WAV export.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./manifest": "./sfx/manifest.json",
    "./sfx/*": "./sfx/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "sfx/manifest.json",
    "scripts/generate.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bash tests/run-tests.sh",
    "generate": "node scripts/generate.mjs",
    "catalog": "node scripts/generate.mjs --catalog-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cportka/8bit-sfx.git"
  },
  "keywords": [
    "8bit",
    "chiptune",
    "sfx",
    "sound-effects",
    "game-audio",
    "procedural",
    "synthesis",
    "webaudio",
    "music",
    "drum-samples",
    "retro",
    "wav"
  ],
  "author": "Chris Portka <chrisportka@gmail.com>",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cportka"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/chrisportka"
    },
    {
      "type": "individual",
      "url": "https://venmo.com/portka"
    }
  ]
}
